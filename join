-- =============================================
-- Automatic Background Guard Loop (Runs Immediately)
-- =============================================
task.spawn(function()
    while true do
        local currentSpace = getAvailableSpace()
        
        -- ถ้าช่องกระเป๋าน้อยกว่า 10 จะเปิดห้องและเข้าด่านให้อัตโนมัติทันที
        if currentSpace < 10 then
            setStatus("⚠️ ช่องเหลือน้อยกว่า 10 (" .. currentSpace .. ") กำลังจอยด่าน...", Color3.fromRGB(255, 200, 50))
            
            executeCreate()
            task.wait(2)
            
            executeStart()
            task.wait(15) -- รอเข้าเกมก่อนเช็คใหม่รอบถัดไป
        else
            setStatus("🛡️ ระบบเช็คอัตโนมัติทำงานอยู่ (ว่าง: " .. currentSpace .. ")", Color3.fromRGB(100, 255, 150))
        end
        
        task.wait(3)
    end
end)

if inventorySpaceLabel and inventorySpaceLabel:IsA("TextLabel") then
    getAvailableSpace()
    inventorySpaceLabel:GetPropertyChangedSignal("Text"):Connect(function()

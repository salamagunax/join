-- =============================================
-- Core Functions
-- =============================================
local function executeCreate()
    syncTime()
    pcall(function()
        LoadingFunnelRemote:FireServer("end", "firstInteraction", { interaction = "playDungeon" })
    end)
    task.wait(0.2)
    local success, result = pcall(function()
        return CreateLobbyRemote:InvokeServer(TargetMap, TargetDifficulty, 0, TargetHardcore, false, false)
    end)
    return success, result
end

local function executeStart()
    syncTime()
    task.wait(0.5) 
    local success, err = pcall(function()
        StartDungeonRemote:FireServer()
    end)
    return success, err
end

local function getAvailableSpace()
    if inventorySpaceLabel and inventorySpaceLabel:IsA("TextLabel") then
        local text = inventorySpaceLabel.Text
        InventoryValLabel.Text = text
        
        for numStr in text:gmatch("%d+") do
            local num = tonumber(numStr)
            if num then
                return num
            end
        end
    end
    return 999
end

